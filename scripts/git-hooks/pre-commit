#!/bin/sh
# Rebuild LaTeX PDFs when a .tex file is staged.
#
# Only .tex sources and their .pdf outputs belong in the repository; every
# other LaTeX file is a regenerable build artifact and is ignored by
# .gitignore.  Enable this hook with:
#
#     git config core.hooksPath scripts/git-hooks
#
# The hook is deliberately tolerant: if no LaTeX compiler is installed it
# prints a warning and lets the commit proceed.

staged_tex=$(git diff --cached --name-only --diff-filter=ACM -- '*.tex')
if [ -z "$staged_tex" ]; then
    exit 0
fi

compiler=""
kind=""
if command -v tectonic >/dev/null 2>&1; then
    compiler="tectonic"; kind="tectonic"
elif command -v latexmk >/dev/null 2>&1; then
    compiler="latexmk"; kind="latexmk"
elif command -v pdflatex >/dev/null 2>&1; then
    compiler="pdflatex"; kind="pdflatex"
else
    # MiKTeX is often installed but not on PATH; fall back to its default
    # Windows locations.
    for candidate in \
        "$LOCALAPPDATA/Programs/MiKTeX/miktex/bin/x64/pdflatex.exe" \
        "/c/Program Files/MiKTeX/miktex/bin/x64/pdflatex.exe" \
        "/c/Program Files (x86)/MiKTeX/miktex/bin/x64/pdflatex.exe"; do
        if [ -x "$candidate" ]; then
            compiler="$candidate"; kind="pdflatex"; break
        fi
    done
fi

if [ -z "$compiler" ]; then
    echo "pre-commit: no LaTeX compiler found (tectonic, latexmk, or pdflatex)."
    echo "pre-commit: skipping PDF rebuild; build and commit the PDF manually."
    exit 0
fi

for tex in $staged_tex; do
    dir=$(dirname "$tex")
    base=$(basename "$tex" .tex)
    pdf="$dir/$base.pdf"
    echo "pre-commit: rebuilding $pdf with $compiler"

    case "$kind" in
        tectonic)
            ( cd "$dir" && "$compiler" -X compile "$base.tex" ) || exit 1
            ;;
        latexmk)
            ( cd "$dir" && "$compiler" -pdf -interaction=nonstopmode -halt-on-error "$base.tex" ) || exit 1
            ;;
        pdflatex)
            ( cd "$dir" && "$compiler" -interaction=nonstopmode -halt-on-error "$base.tex" >/dev/null 2>&1 && \
              "$compiler" -interaction=nonstopmode -halt-on-error "$base.tex" >/dev/null 2>&1 ) || exit 1
            ;;
    esac

    if [ -f "$pdf" ]; then
        git add "$pdf"
    else
        echo "pre-commit: expected $pdf was not produced" >&2
        exit 1
    fi
done

# Belt and braces: never stage LaTeX build artifacts.
artifacts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(aux|log|out|toc|lof|lot|fls|fdb_latexmk|synctex\.gz|bbl|blg|nav|snm|vrb|bcf|run\.xml)$' || true)
if [ -n "$artifacts" ]; then
    echo "pre-commit: unstaging LaTeX build artifacts:"
    echo "$artifacts"
    echo "$artifacts" | while IFS= read -r artifact; do
        [ -n "$artifact" ] && git reset -q -- "$artifact"
    done
fi

exit 0
